<?xml version="1.0" encoding="utf-8"?>
<Application>
  <ActionDesign>
    <Actions>
      <Action Id="AggiornaGeometria" ImageName="SparklineLine" />
      <Action Id="GetIFrame" ImageName="Image_StretchMode" />
      <Action Id="LineLocateAlongRoute" ImageName="RightAngleConnector" />
      <Action Id="SearchMap" ImageName="EnableSearch" PaintStyle="Image" />
    </Actions>
  </ActionDesign>
  <SchemaModules>
    <SchemaModule Name="SystemModule" Version="23.1.5.0" IsNewNode="True" />
    <SchemaModule Name="SystemWindowsFormsModule" Version="23.1.5.0" IsNewNode="True" />
  </SchemaModules>
  <Views>
    <ListView Id="Ordinanza_ListViewMap" EditorTypeName="xRoadMap.Module.Win.Editors.MapListEditor" />
    <ListView Id="Ponte_MapListView" EditorTypeName="xRoadMap.Module.Win.Editors.MapListEditor" />
    <DetailView Id="Strada_DetailView">
      <Items>
        <PropertyEditor Id="Percorso" PropertyEditorType="xRoadMap.Module.Win.Editors.MapEditor" />
      </Items>
    </DetailView>
    <ListView Id="Strada_MapListView" EditorTypeName="xRoadMap.Module.Win.Editors.MapListEditor" />
    <ListView Id="Tombino_MapView" EditorTypeName="xRoadMap.Module.Win.Editors.MapListEditor" />
  </Views>
</Application>