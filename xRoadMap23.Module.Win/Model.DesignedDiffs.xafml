      <OwnMembers>
        <Member Name="UrlCMS" PropertyEditorType="xRoadMap.Module.Win.Editors.WinHyperLinkStringPropertyEditor" MaskSettings="" />
      </OwnMembers>
    </Class>
  </BOModel>
  <SchemaModules>
    <SchemaModule Name="SystemModule" Version="24.2.7.0" IsNewNode="True" />
    <SchemaModule Name="SystemWindowsFormsModule" Version="24.2.7.0" IsNewNode="True" />
  </SchemaModules>
  <Views>
